# 이 파일을 복사해서 .env 로 저장하고 실제 키를 넣으세요.
# .env 는 .gitignore 에 넣어 깃허브에 올라가지 않게 할 것!

# 뉴스 수집 (newsapi.org 무료키)
NEWSAPI_KEY=여기에_newsapi.org_키

# 엘리스 AI 클라우드 (OpenAI 호환 프록시)로 GPT-5.4 호출
ELICE_API_KEY=여기에_elice_키
ELICE_BASE_URL=여기에_elice_base_url
ELICE_MODEL=openai/gpt-5.4

# 감정분류 엔진: finbert(기본, 금융 특화 BERT) | sklearn(자체 학습 모델)
SENTIMENT_ENGINE=finbert
